rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 🔧 HELPER FUNCTIONS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'mansur.ox7@gmail.com',
          'abdulxayavazxanov2012@gmail.com'
        ])
      );
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Profil 80%+ to'ldirilganmi?
    // profileCompletion VA profileCompleteness ikkalasini ham tekshirish
    function hasCompleteProfile() {
      return isSignedIn() && (
        (userDoc(request.auth.uid).get('profileCompletion', 0) >= 80) ||
        (userDoc(request.auth.uid).get('profileCompleteness', 0) >= 80)
      );
    }

    // Admin yoki to'liq profilli user
    function canSendRequests() {
      return isAdmin() || hasCompleteProfile();
    }

    function isValidString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    // ============================================================
    // 🧪 TEST / CONNECTION
    // ============================================================

    match /test/connection {
      allow read: if true;
    }

    // ============================================================
    // 👤 USERS
    // ============================================================

    match /users/{userId} {
      // Profillar ochiq (talents marketplace uchun)
      allow read: if true;

      // Yaratish: faqat o'zi
      allow create: if isUser(userId)
        && request.resource.data.uid == userId;

      // Yangilash: o'zi yoki admin
      // System fields'ni client'dan o'zgartirib bo'lmaydi
      allow update: if (isUser(userId) && !(
        request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isPremium', 'is_premium', 'isOwner', 'is_owner', 'role_locked'])
      )) || isAdmin();

      allow delete: if isAdmin();
    }

    // ============================================================
    // 👮 ADMINS
    // ============================================================

    match /admins/{adminId} {
      // Helper funksiyalar exists() orqali kira oladi
      // Lekin client'dan ko'rinmasligi kerak
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // 💼 JOBS (marketplace e'lonlari)
    // ============================================================

    match /jobs/{jobId} {
      allow read: if true;

      // Yaratish: 80%+ profilga ega yoki admin
      allow create: if canSendRequests()
        && request.resource.data.client_id == request.auth.uid
        && isValidString(request.resource.data.title, 5, 200);

      allow update: if (isSignedIn() && resource.data.client_id == request.auth.uid)
        || isAdmin();

      allow delete: if (isSignedIn() && resource.data.client_id == request.auth.uid)
        || isAdmin();
    }

    // ============================================================
    // 💌 PEER REQUESTS (P2P ish so'rovnomalari) — YANGI
    // ============================================================

    match /peerRequests/{requestId} {
      // O'qish: faqat ishtirokchilar (sender/receiver) yoki admin
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId ||
        isAdmin()
      );

      // Ro'yxat: faqat ishtirokchilar (list query)
      allow list: if isSignedIn();

      // Yaratish: 80%+ profil, o'z nomidan, validation bilan
      allow create: if canSendRequests()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && request.resource.data.status == 'pending'
        && request.resource.data.toUserId is string
        && isValidString(request.resource.data.subject, 5, 200)
        && isValidString(request.resource.data.message, 30, 1000);

      // Yangilash:
      // - Receiver: faqat status, viewedAt, respondedAt
      // - Sender: faqat status='cancelled' (bekor qilish)
      // - Admin: hammasi
      allow update: if isAdmin() || (
        isSignedIn() && (
          (request.auth.uid == resource.data.toUserId
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'respondedAt', 'viewedAt'])
            && request.resource.data.status in ['accepted', 'declined'])
          ||
          (request.auth.uid == resource.data.fromUserId
            && request.resource.data.status == 'cancelled'
            && resource.data.status == 'pending')
        )
      );

      // O'chirish: faqat admin (audit log uchun saqlanadi)
      allow delete: if isAdmin();
    }

    // ============================================================
    // 📋 PROPOSALS (job e'lonlariga taklif) — eski work_requests
    // ============================================================

    match /proposals/{proposalId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.freelancerId ||
        request.auth.uid == resource.data.clientId ||
        isAdmin()
      );

      allow create: if canSendRequests()
        && request.resource.data.freelancerId == request.auth.uid;

      allow update: if isSignedIn() && (
        // Freelancer faqat withdraw qila oladi
        (request.auth.uid == resource.data.freelancerId
          && request.resource.data.status == 'withdrawn')
        ||
        // Client accept/reject qiladi
        (request.auth.uid == resource.data.clientId
          && request.resource.data.status in ['accepted', 'rejected'])
        ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ============================================================
    // 🔔 NOTIFICATIONS — faqat Cloud Function yaratadi
    // ============================================================

    match /notifications/{notifId} {
      // O'qish: faqat egasi
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Yaratish: ❌ Client'dan emas! Faqat Cloud Function
      // (Cloud Function admin SDK orqali yozadi, rules tegmaydi)
      allow create: if false;

      // Yangilash: faqat 'read' flag'ni (o'qildi belgilash)
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // O'chirish: o'zi tozalashi mumkin
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // 💬 CHATS — ikki tomonlama suhbatlar
    // ============================================================

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.participants || isAdmin());

      // Yaratish: o'zi ishtirokchilardan biri
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      // Yangilash: faqat ishtirokchilar (lastMessage, unreadCount va h.k.)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow delete: if isAdmin();

      // ===== Messages subcollection =====
      match /messages/{msgId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && isValidString(request.resource.data.text, 1, 5000);

        // Xabarlarni o'zgartirib bo'lmaydi (faqat readBy qo'shish)
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);

        allow delete: if isAdmin();
      }
    }

    // ============================================================
    // 💬 CONVERSATIONS — ikki tomonlama suhbatlar (App compatibility)
    // ============================================================

    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.participants || isAdmin());

      // Yaratish: o'zi ishtirokchilardan biri
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      // Yangilash: faqat ishtirokchilar (lastMessage, unreadCount va h.k.)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow delete: if isAdmin();

      // ===== Messages subcollection =====
      match /messages/{msgId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && isValidString(request.resource.data.text, 1, 5000);

        // Xabarlarni o'zgartirib bo'lmaydi (faqat readBy qo'shish)
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);

        allow delete: if isAdmin();
      }
    }

    // ============================================================
    // 📨 MESSAGES (eski flat structure — yangi loyihalarda chats/ ishlatildi)
    // ============================================================

    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource != null && request.auth.uid in resource.data.participants)
      );

      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in request.resource.data.participants;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // 🚩 REPORTS (shikoyatlar) — YANGI
    // ============================================================

    match /reports/{reportId} {
      // Yaratish: o'z nomidan, validation bilan
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid  // o'ziga shikoyat yo'q
        && request.resource.data.reason in ['spam', 'inappropriate', 'scam', 'harassment', 'other']
        && request.resource.data.status == 'pending';

      // O'qish: faqat admin
      allow read: if isAdmin();

      // Yangilash/O'chirish: faqat admin
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // 💎 PREMIUM REQUESTS
    // ============================================================

    match /premium_requests/{requestId} {
      allow list: if isAdmin() ||
        (isSignedIn() && resource.data.user_id == request.auth.uid);

      allow get: if isAdmin() ||
        (isSignedIn() && resource.data.user_id == request.auth.uid);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.user_id
        && request.resource.data.status == 'pending';

      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.user_id
         && request.resource.data.status == 'cancelled');
    }

    // ============================================================
    // 📊 PLATFORM STATS (MarketPulse) — global statistika
    // ============================================================

    match /platformStats/{doc} {
      allow read: if true;  // Hamma o'qiy oladi
      allow write: if false;  // Faqat Cloud Function yozadi
    }

    // ============================================================
    // 📰 CONTENT (admin yaratgan mazmun)
    // ============================================================

    match /content/{contentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ============================================================
    // 📈 ACTIVITY LOG
    // ============================================================

    match /activity/{activityId} {
      allow create: if isSignedIn();  // Log yozishga ruxsat (faqat auth bo'lgan)
      allow read: if isAdmin();
      allow update, delete: if false;  // Log o'zgartirilmaydi
    }
  }
}
